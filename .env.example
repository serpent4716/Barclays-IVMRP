# Copy this file to .env (cp .env.example .env) and fill in your values.
# NEVER commit .env or share your key; .env is in .gitignore.

# Get a free key at https://aistudio.google.com/apikey
# Leave as-is (or empty) to run WITHOUT Gemini: the assistant falls back to built-in rules.
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for AI answers, finding explanations and executive summaries
GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for Gemini before falling back to rules
GEMINI_TIMEOUT=20

# Web server port
PORT=5000

# "Today" for SLA/overdue calculations (sample data is dated around this day)
DEMO_TODAY=2026-11-11
