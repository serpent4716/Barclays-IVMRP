# Copy this file to .env (cp .env.example .env) and fill in your values.
# NEVER commit .env or share your key; .env is in .gitignore.

# --- AI Configuration (Tiered: Gemini API -> Ollama Local -> Rule-based Engine) ---
# 1. Google Gemini API (optional cloud AI)
# Get a free key at https://aistudio.google.com/apikey
# Leave as-is (or empty) to fall back to Ollama or built-in rules.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20

# 2. Ollama Local Models (optional on-prem / local AI)
# If Gemini is not configured or unreachable, the system automatically checks Ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:latest
OLLAMA_TIMEOUT=30

# Web server port
PORT=5000

# "Today" for SLA/overdue calculations (sample data is dated around this day)
DEMO_TODAY=2026-11-11
